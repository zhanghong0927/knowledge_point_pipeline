                      "content": "```json\n{\n  \"cards\": [\n    {\n      \"node_code\": \"N_07c95a1dd3b968f3\",\n      \"definition\": \"以铁路为载体的运输系统，涵盖线路、桥隧、机车车辆、通信信号、电气化设施及运营管理、经济规律等全链条技术与学科内容。\",\n      \"boundary\": \"本节点聚焦于“铁路”这一特定运输方式。边界在于区分“铁路”与“公路”（轨道固定、轮轨导向）、“城市轨道”（若树中无独立节点，轻轨/地铁归入特种铁路）、“磁浮”（归入特种铁路）。若内容涉及跨方式联运，主挂载视主导方式而定，纯铁路环节归入本节点。\",\n      \"includes\": [\n        \"铁路基础设施（线路、桥涵、隧道、站场）工程与设计\",\n        \"铁路载运工具（机车、车辆、动车组）及电气化、通信信号系统\",\n        \"铁路运输组织、调度、安全管理及铁路运输经济\"\n      ],\n      \"excludes\": [\n        \"非铁路轨道的公路、水路、航空运输内容\",\n        \"纯城市道路交通管理（非轨道交通部分）\"\n      ],\n      \"sibling_distinctions\": [\n        {\n          \"other_code\": \"N_9a755bf387f3d4d3\",\n          \"rule\": \"区分依据为运行载体与基础设施：铁路依赖固定轨道与轮轨导向，公路依赖路面与轮胎摩擦；铁路机车车辆技术归本节点，汽车技术归公路运输。\"\n        },\n        {\n          \"other_code\": \"N_e47036e6c4613cf9\",\n          \"rule\": \"区分依据为介质：铁路在陆地轨道运行，水路在江河湖海运行；船舶工程归水路，机车工程归铁路。\"\n        }\n      ],\n      \"cross_boundary_rule\": \"若内容涉及“公铁联运”或“铁水联运”，若侧重铁路内部组织与设施，主挂载本节点；若侧重多式联运整体协调，可关联综合运输，但铁路具体技术细节仍归本节点。\"\n    },\n    {\n      \"node_code\": \"N_9a755bf387f3d4d3\",\n      \"definition\": \"以公路为载体的运输系统，涵盖道路、桥隧基础设施，汽车及其他道路运输工具，驾驶使用、维修保养、燃料及运输管理与经济规律。\",\n      \"boundary\": \"本节点聚焦于“公路”及“陆路”运输。边界在于区分“公路”与“铁路”（无固定轨道）、“城市交通”（侧重道路通行与车辆管理，若树中无独立城市交通节点，归入本节点交通工程部分）。若内容涉及高速公路专用技术，归入本节点道路工程。\",\n      \"includes\": [\n        \"公路基础设施（路基、路面、桥涵、隧道）工程与设计\",\n        \"汽车、摩托车、拖拉机等道路运输工具的设计、制造、使用与维修\",\n        \"公路运输组织、交通工程、驾驶员管理及陆路运输经济\"\n      ],\n      \"excludes\": [\n        \"铁路轨道运输内容\",\n        \"水路、航空运输内容\"\n      ],\n      \"sibling_distinctions\": [\n        {\n          \"other_code\": \"N_07c95a1dd3b968f3\",\n          \"rule\": \"区分依据为运行载体：公路运输使用轮胎式车辆，无固定轨道；铁路运输使用轮轨导向车辆，有固定轨道。汽车工程归本节点，机车工程归铁路。\"\n        },\n        {\n          \"other_code\": \"N_e47036e6c4613cf9\",\n          \"rule\": \"区分依据为介质：公路在陆地路面运行，水路在水体运行。\"\n        }\n      ],\n      \"cross_boundary_rule\": \"若内容涉及“公铁联运”，侧重公路段运营与车辆，主挂载本节点；侧重整体协调可关联综合运输。\"\n    },\n    {\n      \"node_code\": \"N_e47036e6c4613cf9\",\n      \"definition\": \"以水路为载体的运输系统，涵盖航道、港口、通航建筑物，船舶设计制造、航海技术、救助打捞及水运管理与经济规律。\",\n      \"boundary\": \"本节点聚焦于“水路”运输（内河与海洋）。边界在于区分“水路”与“管道”（液体/气体介质）、“航空”（空气介质）。若内容涉及“海运”与“内河运输”，均归入本节点。若涉及“智慧水运”，归入本节点智慧水运系统。\",\n      \"includes\": [\n        \"水路基础设施（航道、港口、船闸、升船机）工程与设计\",\n        \"船舶（运输船、工程船、军用舰艇等）的设计、建造、修理及航海技术\",\n        \"水路运输组织、港口作业、救助打捞及水路运输经济\"\n      ],\n      \"excludes\": [\n        \"陆地公路、铁路运输内容\",\n        \"航空运输内容\"\n      ],\n      \"sibling_distinctions\": [\n        {\n          \"other_code\": \"N_07c95a1dd3b968f3\",\n          \"rule\": \"区分依据为介质：水路在水体运行，铁路在陆地轨道运行。\"\n        },\n        {\n          \"other_code\": \"N_9a755bf387f3d4d3\",\n          \"rule\": \"区分依据为介质：水路在水体运行，公路在陆地路面运行。\"\n        },\n        {\n          \"other_code\": \"N_9df705b76a9f262a\",\n          \"rule\": \"区分依据为介质：水路在水体运行，航空在空气运行。\"\n        }\n      ],\n      \"cross_boundary_rule\": \"若内容涉及“铁水联运”或“公水联运”，侧重水路段船舶与港口，主挂载本节点；侧重整体协调可关联综合运输。\"\n    }\n  ]\n}\n```",
