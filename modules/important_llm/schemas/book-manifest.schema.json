{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Markdown extraction input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["books"],
  "properties": {
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["local_name"],
        "additionalProperties": false,
        "properties": {
          "local_name": {"type": "string", "minLength": 1},
          "book_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "title": {"type": "string", "minLength": 1},
          "subject": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "language": {"enum": ["zh", "en", "zh-en", "other", "undetermined"]},
          "service": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
