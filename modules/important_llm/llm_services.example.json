{
  "default": "inference",
  "services": {
    "inference": {
      "base_url": "http://127.0.0.1:8000/v1",
      "api_key_env": "LLM_API_KEY",
      "model": "REPLACE_WITH_DEPLOYED_QWEN38_27B_MODEL_ID",
      "tokenizer_path": "data/tokenizers/qwen3.8-27b",
      "mode": "json",
      "temperature": 0.7,
      "gateway_retries": 10,
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    }
  }
}
